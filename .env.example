# Copy to .env and fill in. .env is gitignored — NEVER commit real values.
# Prefer the AWS credential chain (aws configure) / EKS IRSA. Set keys here only
# if you cannot use `aws configure`.
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY_HERE
AWS_REGION=ap-south-2
S3_BUCKET=qsr-eta-prediction
MODEL_VERSION=local
MODEL_MAPE_GATE=0.18
# Canonical key. If your data currently lives under a different key (e.g. one
# with spaces), do an S3->S3 copy into this one rather than changing this value
# in five places. See the runbook data-reconciliation step.
RAW_KEY=raw/zomato_raw.csv
# api | app | both.  THIS IMAGE IS API-ONLY: streamlit is not installed, so
# app/both will refuse to start. Keep this at api.
ROLE=api
# SHAP costs ~250MB RSS. Leave at 0 on free-tier/small nodes.
ENABLE_SHAP=0
